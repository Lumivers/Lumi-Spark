# ====================================================================
# Lumi Spark — Unreal Engine 5 跨平台专业 EditorConfig 规范
# 适用于 Windows / Linux / macOS 以及 VS、Rider、VS Code、CLion
# ====================================================================
root = true

# 全局默认规则：强制 UTF-8 无 BOM、LF 换行符、行尾空行、清除多余空格
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# --------------------------------------------------------------------
# 1. C / C++ 源码规范（遵循 Epic Games 虚幻引擎官方编码标准）
# 官方标准：使用 Tab 进行缩进，制表符宽度为 4
# --------------------------------------------------------------------
[*.{cpp,h,inl,c,cc,cxx,hpp}]
indent_style = tab
indent_size = 4
tab_width = 4

# --------------------------------------------------------------------
# 2. C# 模块构建与目标文件（.Build.cs / .Target.cs）
# 遵循 C# / .NET 官方规范：4 个空格缩进
# --------------------------------------------------------------------
[*.cs]
indent_style = space
indent_size = 4

# --------------------------------------------------------------------
# 3. 虚幻材质与自定义着色器源码（HLSL / USF / USH）
# --------------------------------------------------------------------
[*.{usf,ush,hlsl,glsl}]
indent_style = tab
indent_size = 4
tab_width = 4

# --------------------------------------------------------------------
# 4. 自动化与工具脚本（Python）
# Python 严格语法：绝对禁止混用 Tab，使用 4 个空格
# --------------------------------------------------------------------
[*.py]
indent_style = space
indent_size = 4

# --------------------------------------------------------------------
# 5. Linux Shell 脚本（严格要求 LF 换行，CRLF 在 Linux 下会报 /bin/bash^M 错误）
# --------------------------------------------------------------------
[*.{sh,bash}]
end_of_line = lf
indent_style = space
indent_size = 4

# --------------------------------------------------------------------
# 6. Windows 批处理脚本（cmd/bat 对 LF 兼容性差，必须保持 CRLF）
# --------------------------------------------------------------------
[*.{bat,cmd}]
end_of_line = crlf

# --------------------------------------------------------------------
# 7. 数据、配置与标记语言（JSON / XML / INI）
# --------------------------------------------------------------------
[*.{json,xml}]
indent_style = space
indent_size = 4

[*.ini]
indent_style = tab
indent_size = 4

# --------------------------------------------------------------------
# 8. YAML 与 Markdown 文档
# YAML 规范：语法上绝对禁止 Tab 字符，必须使用 2 个空格
# --------------------------------------------------------------------
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
